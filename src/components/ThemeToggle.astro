---
import Icon from './Icon.astro'
---
<button
  id="theme-toggle"
  type="button"
  class="theme-toggle"
  aria-label="Ativar tema escuro"
  title="Ativar tema escuro"
>
  <Icon name="sun" class="theme-sun" />
  <Icon name="moon" class="theme-moon" />
</button>
<script>
  const button = document.querySelector<HTMLButtonElement>('#theme-toggle')
  const preference = window.matchMedia('(prefers-color-scheme: dark)')

  function savedTheme() {
    try {
      const value = localStorage.getItem('theme')
      return value === 'dark' || value === 'light' ? value : null
    } catch {
      return null
    }
  }

  function updateTheme(dark: boolean) {
    document.documentElement.classList.toggle('dark', dark)
    const label = dark ? 'Ativar tema claro' : 'Ativar tema escuro'
    button?.setAttribute('aria-label', label)
    button?.setAttribute('title', label)
  }

  function syncTheme() {
    const saved = savedTheme()
    updateTheme(saved ? saved === 'dark' : true)
  }

  button?.addEventListener('click', () => {
    const dark = !document.documentElement.classList.contains('dark')
    updateTheme(dark)
    try {
      localStorage.setItem('theme', dark ? 'dark' : 'light')
    } catch {
      // The toggle still works when browser storage is unavailable.
    }
  })

  preference.addEventListener('change', () => {
    if (!savedTheme()) updateTheme(preference.matches)
  })
  window.addEventListener('storage', (event) => {
    if (event.key === 'theme' || event.key === null) syncTheme()
  })
  syncTheme()
</script>

<style>
.theme-toggle { display: grid; place-items: center; width: 44px; height: 44px; border: 1px solid var(--color-line); border-radius: var(--radius-sm); color: var(--color-muted); }
.theme-toggle :global(.theme-sun) { display: none; }
.theme-toggle :global(.theme-moon) { display: inline-flex; }
:global(.dark) .theme-toggle :global(.theme-sun) { display: inline-flex; }
:global(.dark) .theme-toggle :global(.theme-moon) { display: none; }
.theme-toggle :global(span) { width: 1.25rem; height: 1.25rem; }
.theme-toggle:hover { color: var(--color-accent); background: var(--color-panel); }
</style>
